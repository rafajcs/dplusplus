Package dplusplus;

Helpers
	/* Definições auxiliares */

	digito  =  ['0' .. '9'];
	letra_min = ['a' .. 'z'];
	letra_mai = ['A' .. 'Z'];
	letra 	= letra_min | letra_mai;
	id_char = letra | digito | '_';

	espaco = ' ';
	rc 	= 13;
	nl 	= 10;
	tab = 9;
	all = [0 .. 0xffff];

	not_eol   = [all - [nl + rc]];
	not_dash  = [all - '-'];
	not_close = [all - '}'];


Tokens
	/* ============================================================
       1) LITERAIS, OPERADORES E DELIMITADORES
       Foco: Valores fixos, símbolos matemáticos e pontuação.
	   ============================================================ */


	/* Literais */
	valor_real    = digito+ '.' digito+;
	valor_inteiro = digito+;
	yes = 'yes';
	no  = 'no';

 	/* Operadores Aritméticos e Lógicos */
	soma 	= '+';
	menos 	= '-';
	mult 	= '*';
	div 	= '/';
	igual   = '=';
	menor   = '<';
	maior   = '>';
	nao     = '!';
	and     = 'and';
	or      = 'or';

	/* Operadores Especiais e Delimitadores */
	acesso 		= '->';
	atribuicao  = '<<';
	ponto       = '.';
	e_comercial = '&';
	pipe        = '|';
	par_esq  = '(';
	par_dir  = ')';
	colc_esq = '[';
	colc_dir = ']';


	/* ============================================================
       2) PALAVRAS RESERVADAS E CONTROLE
       Foco: Estruturas de decisão, laços, herança e tipos.
       ============================================================ */


    /* Estruturas de Controle e Blocos */
	finish	= 'finish';
	start 	= 'start';
	in		= 'in';
	case 	= 'case';
	that	= 'that';
	as		= 'as';
	long	= 'long';
	otherwise = 'otherwise';
	if   = 'if';
	else = 'else';

    /* Declarações e OO */
	family		= 'family';
	derives		= 'derives';
	from		= 'from';
	object		= 'object';
	function	= 'function';
	procedure	= 'procedure';
	alterable	= 'alterable';
	unalterable	= 'unalterable';

	/* Tipos Primitivos */
	answer = 'answer';
	number = 'number';

	/* Marcador de Entrada */
	marcador_entrada = '>>';


	/* ============================================================
       3) IDENTIFICADORES, COMENTÁRIOS E IGNORADOS
       Foco: Nomes definidos pelo usuário e tratamento de espaços.
       IMPORTANTE: Estes devem vir por último no arquivo.
       ============================================================ */


	/* Identificadores */
	id_classe	= letra_mai (id_char)*;
	id	= letra_min (id_char)*;

	/* Espaços e Comentários */
	vazio        = (espaco | rc | nl | tab)+;
	coment_linha = '--' not_eol*;
	coment_bloco = '{-' (not_dash | '-'+ not_close)* '-'+ '}';



Ignored Tokens
	/* O que vai ser ignorado por enquanto */
	vazio,
	coment_linha,
	coment_bloco;

Productions

	programa = 
		opt_genealogia lista_definicao_corpo;

	/* substitui o operador opcional */
	opt_genealogia =
		{com_genealogia} genealogia |
		{sem_genealogia} ; /* vazio */

	/* substitui o operador de um ou mais */
	lista_definicao_corpo =
		{multiplas} lista_definicao_corpo definicao_corpo |
		{base} definicao_corpo;

	genealogia = 
		relacao lista_mais_relacao ponto;

	/* substitui o operador zero */
	lista_mais_relacao =
		{multiplas} lista_mais_relacao mais_relacao |
		{base} ; /* vazio */

	mais_relacao = 
		e_comercial relacao;
        
	relacao = 
		family [filho]:id_classe derives from [pai]:id_classe;

	definicao_corpo =
		{classe} declaracao_classe |
		{bloco_principal} bloco_start;

	declaracao_classe =
		object id_classe opt_bloco_componentes;

	/* substitui o operador opcional '?' */
	opt_bloco_componentes =
		{com_componentes} bloco_componentes |
		{sem_componentes} ; /* vazio */

	bloco_componentes =
		colc_esq lista_componentes colc_dir;

	/* Substitui o operador zero ou mais '*' usando recursão à esquerda */
	lista_componentes =
		{multiplos} lista_componentes componentes |
		{base} ; /* vazio */

	componentes =
		{atributo} atributo |
		{metodo} metodo;

	atributo =
		opt_modificador tipo id ponto;

	opt_modificador =
		{com_modificador} modificador |
		{sem_modificador} ; /* vazio */

	modificador =
		{alteravel} alterable |
		{constante} unalterable;

	tipo =
		{inteiro} number |
		{booleano} answer |
		{classe} id_classe;

	metodo =
		{funcao} function tipo id par_esq opt_parametros par_dir bloco_comandos |
		{procedimento} procedure id par_esq opt_parametros par_dir bloco_comandos;

	opt_parametros =
		{com_parametros} parametros |
		{sem_parametros} ; /* vazio */

	parametros =
		parametro lista_mais_parametros;

	/* Substitui o operador zero ou mais '*' usando recursão à esquerda */
	lista_mais_parametros =
		{multiplos} lista_mais_parametros mais_parametros |
		{base} ; /* vazio */

	mais_parametros =
		virgula parametro;

	parametro =
		tipo id;

	bloco_start =
		start bloco_comandos;

	bloco_comandos =
		colc_esq lista_comando colc_dir;

	/* Substitui o operador zero ou mais '*' usando recursão à esquerda */
	lista_comando =
		{multiplos} lista_comando comando |
		{base} ; /* vazio */

	comando =
		{atribuicao} id atribuicao expressao ponto |
		{condicional} if par_esq expressao par_dir [entao]:bloco_comandos opt_cmd_else |
		{retorno} finish opt_expressao ponto;

	opt_cmd_else =
		{com_else} cmd_else |
		{sem_else} ; 

	cmd_else =
		else bloco_comandos;

	opt_expressao =
		{com_expressao} expressao |
		{sem_expressao} ; 


	expressao =
		{ou} expressao or expressao_and |
		{simples} expressao_and;

	expressao_and =
		{e} expressao_and and expressao_relacional |
		{simples} expressao_relacional;

	expressao_relacional =
		{menor} [esq]:expressao_aritmetica menor [dir]:expressao_aritmetica |
		{maior} [esq]:expressao_aritmetica maior [dir]:expressao_aritmetica |
		{igual} [esq]:expressao_aritmetica igual [dir]:expressao_aritmetica |
		{simples} expressao_aritmetica;

	expressao_aritmetica =
		{soma} expressao_aritmetica soma termo |
		{subtracao} expressao_aritmetica menos termo |
		{simples} termo;

	termo =
		{multiplicacao} termo mult fator |
		{divisao} termo div fator |
		{simples} fator;

	fator =
		{id} id |
		{inteiro} valor_inteiro |
		{real} valor_real |
		{booleano_v} yes |
		{booleano_f} no |
		{negacao} nao fator |
		{parenteses} par_esq expressao par_dir;