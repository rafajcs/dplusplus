Package lexico;

Helpers
 digito = ['0' .. '9'];
 char_min = ['a' .. 'z'];
 char_mai = ['A' .. 'Z'];

 espaco = ' ';
 rc = 13;
 nl = 10;
 tab = 9;
 
Tokens
 numero = 
 		'-'? digito+ ('.' digito+)?;
 
 palavra = 
 		(char_min | char_mai | '_')+;
 
 id_classe = 
 		char_mai (char_min | char_mai | digito | '_')*;
 
 id = 
 		char_min (char_min | char_mai | digito | '_')*;
 
 
 atribuicao = 
 		'<<';
 
 soma = 
 		'+';
 menos = 
 		'-';
 mult = 
 		'*';
 div = 
 		'/';
 mod = 
 		'%';
 
 menor_que = 
 		'<';
 maior_que = 
 		'>';
 
 ponto_final = 
 		'.';
 
 par_esq = 
 		'(';
 par_dir = 
 		')';
 colc_esq = 
 		'[';
 colc_dir = 
 		']';
 
 
 vazio = (espaco | rc | nl | tab)+;


Ignored Tokens
 vazio;

