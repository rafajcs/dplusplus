{-
    LinkedList.dpp
    OOP com herança, tipagem recursiva, imperativo e expressões matemáticas.
-}

family No derives from NoBase .

family NoBase start

    function number getValor[] .

finish

family No start

    object No proximo.
    alterable number valor << 0.

    procedure setValor[number v] start
        valor << v.
    finish

    function number getValor[] start valor finish

    procedure setProximo[No n] start
        proximo << n.
    finish

finish


family Lista start

    object No cabeca.
    alterable number tamanho << 0.

    procedure inserir[number v] start

        object No novo.

        novo->setValor[v].
        novo->setProximo[cabeca].
        cabeca << novo.
        tamanho << tamanho + 1.

    finish

    function number getTamanho[] start tamanho finish

finish


family Programa start

    >> procedure main[] start

        object Lista l.
        object Periphericals io.
        alterable number a << 5.
        alterable number b << 10.
        alterable number resultado << 0.

        l->inserir[1].
        l->inserir[2].
        l->inserir[3].

        -- Expressoes matematicas: +, -, *, /
        resultado << (a + b) * 2 - b / 5.

        io->show[resultado].

        -- Operador > e in case that sem otherwise
        in case that (resultado > 0) start
            io->show[resultado].
        finish

        -- Operador or e in case that com otherwise
        in case that ((a > b) or (resultado = 0)) start
            io->show[a].
        finish otherwise start
            io->show[- resultado].
        finish

        -- as long as
        as long as (a < b) start
            a << a + 1.
            io->show[a].
        finish

        -- operador ternario (if/else)
        resultado << if (a < b) a + b else a - b.

        io->show[resultado].

    finish

finish
